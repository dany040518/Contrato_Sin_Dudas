# ============================================================
# CONTRATO SIN DUDAS — Variables de Entorno
# ============================================================
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================


# ------------------------------------------------------------
# OPENROUTER
# Obtén tu key en: https://openrouter.ai/keys
# Usada en: Ingesta de Documentos, Embeddings OpenRouter, RAG Final
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# SUPABASE
# Encuentra estos valores en: Supabase Dashboard → Settings → API
# Proyecto: rnrtfnzpdghlzsmjxzxr
# ------------------------------------------------------------

# URL del proyecto
SUPABASE_URL=https://rnrtfnzpdghlzsmjxzxr.supabase.co

# Clave anon/public (lectura desde el frontend si es necesario)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role (SOLO para n8n — nunca exponer en frontend)
# Usada en: RAG Final (match_contract_chunks RPC)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de Storage (para subir archivos al bucket "contracts")
# Usada en: Ingesta de Documentos (Upload to bucket)
SUPABASE_STORAGE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# N8N WEBHOOKS
# Cambiar cuando n8n se despliegue en Railway/Render/n8n Cloud
# ------------------------------------------------------------
WEBHOOK_UPLOAD=http://localhost:5678/webhook/subir-contrato
WEBHOOK_QUERY=http://localhost:5678/webhook/consultar


# ------------------------------------------------------------
# GOOGLE (para workflow Reminder)
# Obtén tu key en: https://aistudio.google.com/app/apikey
# Gmail: requiere OAuth2 configurado en n8n UI
# ------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email destino para alertas de vencimiento de contratos
REMINDER_EMAIL=tu-email@gmail.com
