      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres un analista legal. Extrae SOLO las fechas de inicio y fin del contrato del siguiente texto.\\n\\nResponde ÚNICAMENTE con JSON válido, sin texto adicional:\\n{\\\"fecha_inicio\\\": \\\"YYYY-MM-DD\\\", \\\"fecha_fin\\\": \\\"YYYY-MM-DD\\\"}\\n\\nSi no encuentras una fecha, usa null.\\n\\nTexto:\\n{{ $json.full_text }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        624,
        0
      ],
      "id": "2c8d56f3-a2e2-4734-a67d-463102b232ca",
