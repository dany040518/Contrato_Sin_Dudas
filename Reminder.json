    {
      "parameters": {
        "jsCode": "const groups = {};\n\nfor (const item of $input.all()) {\n  const { contract_id, chunk } = item.json;\n  if (!groups[contract_id]) groups[contract_id] = [];\n  groups[contract_id].push(chunk);\n}\n\nreturn Object.entries(groups).map(([contract_id, chunks]) => ({\n  json: {\n    contract_id,\n    full_text: chunks.join(' ')\n  }\n}));"
      },
