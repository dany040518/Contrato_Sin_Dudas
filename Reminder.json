      ],
      "id": "39230dc8-f697-4d93-b9cf-8e6382596213",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "pTs50KgFbmBIIGOj",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\nconst twoWeeks = new Date(today);\ntwoWeeks.setUTCDate(today.getUTCDate() + 14);\n\nconst alerts = [];\n\nfor (const item of $input.all()) {\n  const contract_id = item.json.contract_id || 'unknown';\n  const raw = item.json.output || '';\n\n  let dates = {};\n  try {\n    const match = raw.match(/\\{[\\s\\S]*\\}/);\n    if (match) dates = JSON.parse(match[0]);\n  } catch (e) {}\n\n  const { fecha_inicio, fecha_fin } = dates;\n\n  const start = fecha_inicio ? new Date(fecha_inicio) : null;\n  const end   = fecha_fin   ? new Date(fecha_fin)   : null;\n\n  if (start && start >= today && start <= twoWeeks) {\n    alerts.push({ json: {\n      contract_id,\n      tipo_alerta: 'Inicio proximo',\n      fecha: fecha_inicio,\n      mensaje: `Contrato ${contract_id} INICIA el ${fecha_inicio}.`\n    }});\n  }\n\n  if (end && end >= today && end <= twoWeeks) {\n    alerts.push({ json: {\n      contract_id,\n      tipo_alerta: 'Vencimiento proximo',\n      fecha: fecha_fin,\n      mensaje: `Contrato ${contract_id} VENCE el ${fecha_fin}.`\n    }});\n  }\n}\n\nreturn alerts;"
      },
