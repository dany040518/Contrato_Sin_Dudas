    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENROUTER_API_KEY"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://n8n.local"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"openai/gpt-4o-mini\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"Eres un analista legal experto en contratos.\\n\\nTu tarea es EXTRAER información estructurada del contrato.\\n\\nREGLAS:\\n- Responde SOLO en JSON válido\\n- NO agregues texto fuera del JSON\\n- Si no encuentras un dato explícito, dedúcelo del contexto del contrato\\n- Si definitivamente no existe, usa null\\n- Fechas en formato YYYY-MM-DD\\n- Valor numérico sin símbolos\\n\\nJSON esperado:\\n{\\n  \\\"entidad\\\": \\\"\\\",\\n  \\\"proveedor\\\": \\\"\\\",\\n  \\\"tipo\\\": \\\"\\\",\\n  \\\"valor\\\": 0,\\n  \\\"fecha_inicio\\\": \\\"YYYY-MM-DD\\\",\\n  \\\"fecha_fin\\\": \\\"YYYY-MM-DD\\\",\\n  \\\"duracion_meses\\\": 0,\\n  \\\"resumen\\\": \\\"\\\",\\n  \\\"clausulas_clave\\\": []\\n}\\n\\nContrato:\\n\" + $json.text\n    }\n  ],\n  temperature: 0\n} }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -768,
        256
      ],
      "id": "b3a58fe3-873f-41b3-8f80-88f37e748064",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://rnrtfnzpdghlzsmjxzxr.supabase.co/storage/v1/object/contracts/{{ $('Webhook').item.binary.file.fileName.replace(/\\s+/g, '_').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-zA-Z0-9._-]/g, '_') + '.pdf' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_STORAGE_KEY"
            },
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_STORAGE_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/pdf",
        "body": "={{ $('Webhook').item.binary.file.data }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -960,
        48
      ],
      "id": "fef6237f-6c22-47ab-bf87-219042df9d91",
      "name": "Upload to bucket",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const contractId = 'C-' + Date.now();\n\n// archivo\nconst fileName = $('Webhook').item.binary.file.fileName;\nconst fileUrl = `https://rnrtfnzpdghlzsmjxzxr.supabase.co/storage/v1/object/public/contracts/${fileName}`;\n\n// texto OCR\nconst fullText = $('Extract from File').item.json.text;\n\n// respuesta IA\nlet aiData = {};\n\ntry {\n  const rawResponse = $('HTTP Request1').item.json.choices?.[0]?.message?.content || '';\n  const match = rawResponse.match(/\\{[\\s\\S]*\\}/);\n\n  if (match) {\n    aiData = JSON.parse(match[0]);\n  }\n\n} catch (e) {\n  aiData = {};\n}\n\n// limpiar número\nconst safeNumber = (val) => {\n  if (!val) return null;\n  const num = Number(val.toString().replace(/[^\\d.-]/g, ''));\n  return isNaN(num) ? null : num;\n};\n\nreturn [{\n  json: {\n    // 🔑 contracts\n    entidad: aiData.entidad || 'No especificado',\n    proveedor: aiData.proveedor || 'No especificado',\n    tipo: aiData.tipo || 'No especificado',\n    valor: safeNumber(aiData.valor),\n    fecha_inicio: aiData.fecha_inicio || null,\n    fecha_fin: aiData.fecha_fin || null,\n\n    // 📁 contract_files\n    contract_id: contractId,\n    file_name: fileName,\n    file_url: fileUrl,\n\n    // 📄 contract_texts\n    full_text: fullText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
