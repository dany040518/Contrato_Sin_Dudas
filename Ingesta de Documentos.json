    {
      "parameters": {
        "jsCode": "const chunkSize = 300;\nlet result = [];\n\nconst entidad = $('Code in JavaScript').first().json.entidad || '';\nconst tipo = $('Code in JavaScript').first().json.tipo || '';\n\nfor (const item of $input.all()) {\n  const text = item.json.full_text || \"\";\n  const contractId = item.json.contract_id;\n\n  if (!text || !contractId) continue;\n\n  const words = text.split(\" \");\n\n  for (let i = 0; i < words.length; i += chunkSize) {\n    result.push({\n      json: {\n        contract_id: contractId,\n        chunk: words.slice(i, i + chunkSize).join(\" \"),\n        entidad: entidad,\n        tipo: tipo\n      }\n    });\n  }\n}\n\nreturn result;"
      },
