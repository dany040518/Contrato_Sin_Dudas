      ],
      "id": "8d6a41f0-a0be-4bda-ab77-0bee8a580102",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst context = items.map(i => {\n  const partes = [i.json.entidad, i.json.tipo]\n    .filter(v => v && v.trim() && v !== 'No especificado');\n  const label = partes.length > 0\n    ? `CONTRATO: ${partes.join(' — ')}`\n    : 'FRAGMENTO DE CONTRATO';\n  return `${label}\\nSIMILITUD: ${i.json.similarity?.toFixed(3) || 'N/A'}\\nCONTENIDO:\\n${i.json.chunk}`;\n}).join(\"\\n\\n====================\\n\\n\");\n\nreturn [{ json: { context, question: $('Webhook').first().json.body.question } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -160
      ],
      "id": "96d17756-5d47-4cdc-8eb9-be058bbf4afd",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENROUTER_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: \"meta-llama/llama-3-8b-instruct\",\n  messages: [\n    {\n      role: \"system\",\n      content: `Eres un analista experto en contratos legales de cualquier tipo.\n\nREGLAS CRÍTICAS — FORMATO DE RESPUESTA:\n- NUNCA menciones IDs técnicos, UUIDs ni códigos internos (ej: \"4084074a-9a6f-...\"). Ignóralos aunque aparezcan en el contexto.\n- Identifica cada contrato por: tipo, entidad, proveedor o fechas.\n- Formato para referirte a un contrato: \"[Tipo] con [Entidad/Proveedor]\" o \"el contrato de [tipo]\"\n- Si hay varios contratos relevantes, menciónalos a todos con nombre comprensible.\n\nREGLAS DE ANÁLISIS:\n- NO sumes valores salvo que se pida explícitamente\n- Distingue: canon/precio principal vs depósitos/garantías vs pagos adicionales\n- Si no encuentras la respuesta → \"No encontré información sobre eso en los contratos disponibles\"\n- No inventes información que no esté en el contexto\n- Si la pregunta es general, responde usando todos los contratos disponibles\n`\n    },\n    {\n      role: \"user\",\n      content: `CONTEXTO:\n${$json.context}\n\nPREGUNTA:\n${$json.question}\n\nResponde de forma directa:`\n    }\n  ]\n} }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        624,
        -160
      ],
